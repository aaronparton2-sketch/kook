# KOOK - a checklist of what to collect.
# In n8n these belong in CREDENTIALS and the Kook settings node, not in a .env file.

# Twilio - the call on the surf + the sick text
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
MY_MOBILE=

# Telegram - the Chase Barrels / Go to work buttons (bot from @BotFather)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Anthropic - the crowd count
ANTHROPIC_API_KEY=

# Google Calendar - connect in n8n with OAuth, then copy your calendar id
GOOGLE_CALENDAR_ID=

# Voice - you only need one
ELEVENLABS_API_KEY=
ELEVENLABS_AGENT_ID=
ELEVENLABS_PHONE_NUMBER_ID=
BLAND_API_KEY=

# The bakery
BAKERY_PHONE=
